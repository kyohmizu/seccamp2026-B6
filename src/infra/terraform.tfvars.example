# ==== 共通設定 ====
# 課金/クォータ用のプロジェクト。1プロジェクト共有なら、そのプロジェクトを指定する。
google_project = "your-project-id"
region         = "asia-northeast1"

# ============================================================================
# 構築モードを1つ選びます。モードA（app_count）とモードB（environments）は
# 同時には使いません。どちらか一方だけを有効にしてください。
# ============================================================================

# ---- モードA: 一括生成（GitHub 連携あり・複数人分を一括構築する場合の既定） ----
# 1プロジェクトに app-01..app-NN を GitHub 連携付き（push/PR/deploy トリガー）で
# 環境数分まとめて自動生成する。事前に host connection（connection_name）を
# gcloud で作成・OAuth 認可しておくこと。
app_count       = 10
github_owner    = "your-org"           # 個人アカウント名 or 組織名
connection_name = "flowpay-github"     # gcloud で作成済みの Cloud Build 接続名
npm_registry    = "http://<IP>:4873/"  # 演習用 npm レジストリ（Verdaccio）。IP を含むためコミットしない

# ---- モードB: 環境明示（環境ごとに個別設定する場合） ----
# app_count = 0 にして environments を1つ定義する。モードA の4行（app_count / github_owner /
# connection_name / npm_registry）はコメントアウトする。
# 各 env は project_id（必須）に、必要な属性だけを足す（下は全属性を並べた例）。
# github_repo を指定しない env はトリガーが作られず、ビルド・デプロイは seed-builds.sh（手動）。
# GitHub 連携なしで1環境だけ試す最小構成は terraform.tfvars.minimal.example をコピーして使う。

# app_count = 0
# environments = {
#   app-01 = {
#     project_id      = "your-project-id"
#     members         = ["user:app-01@example.com"]  # frontend を proxy 閲覧できるアカウント（不要なら省略）
#
#     # ↓ GitHub トリガー（push/PR/deploy の自動ビルド）を作る場合のみ。不要なら github_owner 以降をすべて省略。
#     #   host connection は gcloud で作成・OAuth 認可済みにしておく。
#     github_owner             = "your-org"
#     github_repo              = "seccamp2026-B6-app-01"  # トリガー対象のリポジトリ名
#     connection_name          = "flowpay-github"
#     build_sa                 = "projects/your-project-id/serviceAccounts/<project-number>-compute@developer.gserviceaccount.com"  # トリガーのビルド実行 SA（2nd-gen は必須）。既定の Compute SA を指定
#     substitutions            = { _NPM_REGISTRY = "http://<IP>:4873/" }
#     # 実行する cloudbuild 定義のパス。個別リポジトリはルート直下のファイル名を指定する。
#     #   本リポジトリ（src/ 配下）を使用する場合は以下を省略する（既定 = src/pipelines/ の各定義ファイル）。
#     cloudbuild_config        = "cloudbuild.yaml"
#     pr_cloudbuild_config     = "cloudbuild.pr.yaml"
#     deploy_cloudbuild_config = "cloudbuild.deploy.yaml"
#   }
# }
